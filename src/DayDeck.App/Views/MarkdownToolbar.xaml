<UserControl x:Class="DayDeck.App.Views.MarkdownToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tool" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Margin" Value="0,0,1,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>
    <!-- 할 일 메모 등 작은 입력란용 서식 도구 (메모 화면과 같은 동작) -->
    <DockPanel>
        <ToggleButton x:Name="PreviewToggle" DockPanel.Dock="Right" Content="미리보기" FontSize="11.5" Padding="6,1" Height="24"
                      Focusable="False" Checked="OnPreviewChanged" Unchecked="OnPreviewChanged"
                      ToolTip="서식이 적용된 모양 보기 (링크 열기, 체크 상자 체크)" AutomationProperties.Name="메모 미리보기" />
        <WrapPanel>
            <Button Style="{StaticResource Tool}" Click="OnBold" ToolTip="굵게 (Ctrl+B)" AutomationProperties.Name="메모 굵게">
                <TextBlock Text="B" FontWeight="Bold" />
            </Button>
            <Button Style="{StaticResource Tool}" Click="OnItalic" ToolTip="기울임 (Ctrl+I)" AutomationProperties.Name="메모 기울임">
                <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia, Times New Roman" />
            </Button>
            <Button Style="{StaticResource Tool}" Click="OnUnderline" ToolTip="밑줄 (Ctrl+U)" AutomationProperties.Name="메모 밑줄">
                <TextBlock Text="U" TextDecorations="Underline" />
            </Button>
            <Button Style="{StaticResource Tool}" Click="OnStrike" ToolTip="취소선 (Ctrl+Shift+X)" AutomationProperties.Name="메모 취소선">
                <TextBlock Text="S" TextDecorations="Strikethrough" />
            </Button>
            <Button Style="{StaticResource Tool}" Click="OnHighlight" ToolTip="형광펜 (Ctrl+Shift+H)" AutomationProperties.Name="메모 형광펜">
                <TextBlock Text="H" Background="#FFF3A3" Foreground="#1B1B1B" Padding="2,0" />
            </Button>
            <Button Style="{StaticResource Tool}" x:Name="ColorButton" Click="OnColor" ToolTip="글자색" AutomationProperties.Name="메모 글자색">
                <StackPanel>
                    <TextBlock Text="A" HorizontalAlignment="Center" Margin="0,-1,0,-2" />
                    <Border x:Name="ColorSwatch" Height="3" Width="12" Background="#C42B1C" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Tool}" Click="OnLink" ToolTip="링크 (Ctrl+K)" AutomationProperties.Name="메모 링크" Content="🔗" />
            <Border Width="1" Margin="4,5" Background="{DynamicResource LineBrush}" />
            <Button Style="{StaticResource Tool}" Click="OnBullet" ToolTip="글머리 목록 (Ctrl+Shift+8)" AutomationProperties.Name="메모 글머리 목록" Content="•" />
            <Button Style="{StaticResource Tool}" Click="OnNumbered" ToolTip="번호 목록 (Ctrl+Shift+7)" AutomationProperties.Name="메모 번호 목록" Content="1." />
            <Button Style="{StaticResource Tool}" Click="OnTask" ToolTip="체크 목록 (Ctrl+Shift+9)" AutomationProperties.Name="메모 체크 목록" Content="☐" />
        </WrapPanel>
    </DockPanel>
</UserControl>
