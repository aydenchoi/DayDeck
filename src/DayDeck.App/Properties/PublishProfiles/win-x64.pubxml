<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/DayDeck.App -p:PublishProfile=win-x64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- 압축하지 않는다. 압축하면 exe는 65MB로 작아지지만 실행할 때마다 메모리에 풀어서
         트레이 표시가 0.56~0.87초로 늦고 Private Bytes가 96MB로 커진다 (압축 안 함: 0.33~0.36초, 24MB). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- composite R2R은 끈다. 단일 파일 + ReadyToRun이면 SDK가 기본으로 켜서 .NET·WPF 전체를 앱과 함께 다시 컴파일한
         82MB짜리 DayDeck.r2r.dll을 exe에 넣는다. 끄면 Microsoft가 미리 컴파일해 둔 프레임워크 코드를 그대로 써서
         exe가 148MB에서 131MB로 줄어든다. -->
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <DebugType>none</DebugType>
    <PublishDir>..\..\artifacts\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
