<Window x:Class="DayDeck.App.Views.LinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="링크 넣기" Width="420" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="20,16">
        <TextBlock Text="주소" FontSize="13" Foreground="{DynamicResource TextBrush}" />
        <TextBox x:Name="UrlBox" Margin="0,6,0,0" Padding="4,5" FontSize="13" AutomationProperties.Name="링크 주소" />
        <TextBlock Text="표시할 글자 (비우면 주소)" FontSize="13" Margin="0,12,0,0" Foreground="{DynamicResource TextBrush}" />
        <TextBox x:Name="LabelBox" Margin="0,6,0,0" Padding="4,5" FontSize="13" AutomationProperties.Name="링크 글자" />
        <TextBlock x:Name="ErrorText" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource DangerBrush}" Visibility="Collapsed"
                   Text="웹 주소(https://…, www.…)나 메일 주소를 입력하세요." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="넣기" Width="80" Padding="0,4" IsDefault="True" Click="OnOk" Style="{StaticResource AccentButton}" />
            <Button Content="취소" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
