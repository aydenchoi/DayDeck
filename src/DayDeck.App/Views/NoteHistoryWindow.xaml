<Window x:Class="DayDeck.App.Views.NoteHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메모 기록" Width="860" Height="580" MinWidth="560" MinHeight="360" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}">
    <DockPanel Margin="16,12,16,14">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock DockPanel.Dock="Top" FontSize="12" Margin="0,2,0,10" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                   Text="자동 저장할 때 10분에 한 번씩 예전 내용을 남깁니다 (메모마다 최근 30개). 되돌려도 지금 내용은 기록에 남으니 다시 돌아올 수 있습니다." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="닫기" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" x:Name="RestoreButton" Content="이 버전으로 되돌리기" Padding="14,4" IsEnabled="False"
                    Click="OnRestore" Style="{StaticResource AccentButton}" />
            <TextBlock x:Name="StatusText" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Versions" SelectionChanged="OnVersionSelected" AutomationProperties.Name="버전 목록"
                     BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource CardBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,3">
                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding Detail}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyText" Grid.Column="0" Margin="12" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}"
                       Visibility="Collapsed" Text="아직 남은 기록이 없습니다. 메모를 고치고 10분쯤 지나 다시 저장하면 생깁니다." />
            <Border Grid.Column="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                <Grid>
                    <FlowDocumentScrollViewer x:Name="Preview" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="버전 내용" />
                    <TextBox x:Name="PlainPreview" IsReadOnly="True" BorderThickness="0" Padding="16,12" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Visibility="Collapsed" AutomationProperties.Name="버전 원문" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
