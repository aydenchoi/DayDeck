<Window x:Class="DayDeck.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="20,16">
        <TextBlock x:Name="PromptText" FontSize="13" Foreground="{DynamicResource TextBrush}" />
        <TextBox x:Name="InputBox" Margin="0,10,0,0" Padding="4,5" FontSize="13" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="확인" Width="80" Padding="0,4" IsDefault="True" Click="OnOk" />
            <Button Content="취소" Width="80" Padding="0,4" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
