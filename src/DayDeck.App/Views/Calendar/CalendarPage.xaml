<UserControl x:Class="DayDeck.App.Views.Calendar.CalendarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <UserControl.Resources>
        <Style x:Key="NavButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="ViewToggle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="GroupName" Value="CalendarView" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bg" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="ShowTodos" Content="할 일 표시" VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12" Click="OnShowTodosChanged" />
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5" ClipToBounds="True" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MonthButton" Style="{StaticResource ViewToggle}" Content="월" ToolTip="월 (M)" Checked="OnViewChecked" />
                        <RadioButton x:Name="WeekButton" Style="{StaticResource ViewToggle}" Content="주" ToolTip="주 (W)" Checked="OnViewChecked" />
                        <RadioButton x:Name="DayButton" Style="{StaticResource ViewToggle}" Content="일" ToolTip="일 (D)" Checked="OnViewChecked" />
                        <RadioButton x:Name="AgendaButton" Style="{StaticResource ViewToggle}" Content="목록" ToolTip="목록 (A)" Checked="OnViewChecked" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource AccentButton}" Content="＋ 새 일정" Click="OnNewEvent" ToolTip="새 일정 (Ctrl+N)"
                        Height="30" Padding="10,0" FontSize="12.5" Margin="0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource NavButton}" Content="‹" Click="OnPrevious" ToolTip="이전 (←)" AutomationProperties.Name="이전" />
                <Button Style="{StaticResource NavButton}" Content="›" Click="OnNext" ToolTip="다음 (→)" AutomationProperties.Name="다음" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,12,0"
                           Foreground="{DynamicResource TextBrush}" />
                <Button Style="{StaticResource NavButton}" Content="오늘" Click="OnToday" ToolTip="오늘 (T)" />
            </StackPanel>
        </DockPanel>

        <!-- 미니 달력: 주/일/목록 보기에서, 창이 넓을 때만 -->
        <Border x:Name="MiniHost" DockPanel.Dock="Left" Width="200" Margin="0,0,12,0" Padding="10,8" VerticalAlignment="Top"
                BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource CardBrush}"
                Visibility="Collapsed" />
        <Border BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource CardBrush}" ClipToBounds="True">
            <ContentControl x:Name="ViewHost" Focusable="False" />
        </Border>
    </DockPanel>
</UserControl>
