<UserControl x:Class="DayDeck.App.Views.WeeklyReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="주간업무보고" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock FontSize="13" Margin="0,2,0,12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap"
                       Text="제목과 날짜는 주차에서 자동으로 정해집니다 (주차는 목요일 기준). 금주실적과 차주계획 내용만 쓰면 자동 저장됩니다." />
            <DockPanel Margin="0,0,0,12">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyButton" Content="📋 복사" Padding="14,4" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Click="OnCopy"
                            ToolTip="보고 전체를 클립보드에 복사 (메일·메신저에 붙여 넣기)" AutomationProperties.Name="보고 복사" />
                    <Button x:Name="DeleteButton" Content="삭제" Padding="12,4" Margin="8,0,0,0" Click="OnDelete"
                            ToolTip="이 주 보고를 휴지통으로 (30일 동안 복원)" AutomationProperties.Name="보고 삭제" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="◀ 지난주" Padding="10,4" Click="OnPreviousWeek" AutomationProperties.Name="지난주" />
                    <Button Content="이번 주" Padding="10,4" Margin="6,0,0,0" Click="OnThisWeek" AutomationProperties.Name="이번 주" />
                    <Button Content="다음 주 ▶" Padding="10,4" Margin="6,0,0,0" Click="OnNextWeek" AutomationProperties.Name="다음 주" />
                    <DatePicker x:Name="JumpDate" Width="150" Margin="12,0,0,0" FirstDayOfWeek="Monday" VerticalContentAlignment="Center"
                                SelectedDateChanged="OnJumpDate" ToolTip="날짜를 고르면 그 날짜가 있는 주로" AutomationProperties.Name="날짜로 이동" />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 저장된 보고 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="저장된 보고" FontSize="12" Foreground="{DynamicResource SubTextBrush}" Margin="8,4,0,6" />
                    <Grid>
                        <ListBox x:Name="ReportList" BorderThickness="0" Background="Transparent" SelectionChanged="OnReportSelected"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="WeeklyReportList"
                                 AutomationProperties.Name="저장된 보고" />
                        <TextBlock x:Name="ListEmpty" Text="아직 저장된 보고가 없습니다." FontSize="12.5" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- 보고 쓰기 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WeekTitle" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                                       AutomationProperties.AutomationId="WeeklyReportTitle" />
                            <Border x:Name="CurrentChip" Background="{DynamicResource AccentBrush}" CornerRadius="9" Padding="8,1" Margin="10,2,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="이번 주" FontSize="11.5" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="WeekLabel" FontSize="12.5" Foreground="{DynamicResource SubTextBrush}" Margin="0,2,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" x:Name="DoneHeader" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource TextBrush}"
                               AutomationProperties.AutomationId="WeeklyReportDoneHeader" />
                    <TextBox Grid.Row="2" x:Name="DoneBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="6,4" AutomationProperties.Name="금주실적" />

                    <TextBlock Grid.Row="3" x:Name="PlanHeader" FontSize="14" FontWeight="SemiBold" Margin="0,14,0,4" Foreground="{DynamicResource TextBrush}"
                               AutomationProperties.AutomationId="WeeklyReportPlanHeader" />
                    <TextBox Grid.Row="4" x:Name="PlanBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" Padding="6,4" AutomationProperties.Name="차주계획" />

                    <TextBlock Grid.Row="5" x:Name="StatusText" FontSize="12" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="WeeklyReportStatus" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
