<Window x:Class="DayDeck.App.Views.ReminderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayDeck.App.ViewModels"
        xmlns:views="clr-namespace:DayDeck.App.Views"
        Title="DayDeck 알림"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource UiFont}" Background="{DynamicResource PopupBrush}"
        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="CardButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}" BasedOn="{StaticResource AccentButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel>
        <!-- 머리글: 끌어서 옮길 수 있다 -->
        <DockPanel DockPanel.Dock="Top" Background="{DynamicResource PopupHeaderBrush}" MouseLeftButtonDown="OnHeaderDrag" Height="30">
            <Button DockPanel.Dock="Right" Content="모두 닫기" x:Name="CloseAllButton" Background="Transparent" BorderThickness="0"
                    Padding="10,0" FontSize="11" Foreground="{DynamicResource SubTextBrush}" Click="OnCloseAll" Cursor="Hand" />
            <Image Source="pack://application:,,,/Assets/app.ico" Width="16" Height="16" Margin="10,0,6,0" />
            <TextBlock Text="DayDeck" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Cards" Margin="0,0,0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ReminderCardViewModel}">
                        <views:AutomationGroup AutomationProperties.Name="{Binding AutomationName}">
                            <Border x:Name="Card" Margin="8,8,8,4" Padding="14,10,10,12" Background="{DynamicResource CardBrush}" CornerRadius="6"
                                    BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                                                Foreground="{DynamicResource SubTextBrush}" Click="OnDismiss" Tag="{Binding}" Cursor="Hand"
                                                AutomationProperties.Name="닫기" ToolTip="확인 (다시 울리지 않음)" />
                                        <TextBlock x:Name="HeaderText" Text="{Binding Header}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="14.5" FontWeight="Bold" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Text="{Binding Body}" FontSize="12" Foreground="{DynamicResource SubTextBrush}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Visibility="{Binding HasBody, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Lines}" Margin="0,6,0,0"
                                                  Visibility="{Binding HasLines, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis" Margin="0,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- 할 일 하나 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding IsSingle, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource PrimaryButton}" Content="✓ 완료" Click="OnComplete" Tag="{Binding}" />
                                        <Button Style="{StaticResource CardButton}" Content="{Binding DataContext.SnoozeLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Click="OnSnoozeDefault" Tag="{Binding}" AutomationProperties.Name="스누즈" Margin="0" />
                                        <Button Style="{StaticResource CardButton}" Content="▾" Click="OnSnoozeMenu" Tag="{Binding}" Padding="6,0"
                                                AutomationProperties.Name="스누즈 시간 선택" ToolTip="다른 시간으로 스누즈" />
                                        <Button Style="{StaticResource CardButton}" Content="열기" Click="OnOpen" Tag="{Binding}" />
                                    </StackPanel>

                                    <!-- 놓친 알림 묶음 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding IsMissed, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource PrimaryButton}" Content="모두 확인" Click="OnDismiss" Tag="{Binding}" />
                                        <Button Style="{StaticResource CardButton}" Content="1시간 후 다시" Click="OnSnoozeHour" Tag="{Binding}" />
                                        <Button Style="{StaticResource CardButton}" Content="오늘 화면 열기" Click="OnOpenToday" Tag="{Binding}" />
                                    </StackPanel>

                                    <!-- 브리핑 -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                                Visibility="{Binding IsBriefing, Converter={StaticResource BoolToVisibility}}">
                                        <Button Style="{StaticResource PrimaryButton}" Content="오늘 화면 열기" Click="OnOpenToday" Tag="{Binding}" />
                                        <Button Style="{StaticResource CardButton}" Content="확인" Click="OnDismiss" Tag="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </views:AutomationGroup>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsMissed}" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                <Setter TargetName="HeaderText" Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
