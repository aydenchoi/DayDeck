<Window x:Class="DayDeck.App.Views.QuickAddWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="빠른 추가" Width="640" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Background="{DynamicResource PopupBrush}" BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <StackPanel>
        <Grid Margin="18,14,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="＋" FontSize="22" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,0,12,0" />
            <Grid Grid.Column="1">
                <!-- 인식한 부분을 색으로 보여 주는 층. 같은 글꼴로 입력창 뒤에 겹친다. -->
                <TextBlock x:Name="Highlight" FontSize="17" Margin="2,1,0,0" TextWrapping="Wrap" />
                <TextBox x:Name="Input" FontSize="17" BorderThickness="0" Padding="0" Background="Transparent"
                         Foreground="Transparent" CaretBrush="{DynamicResource TextBrush}" TextWrapping="Wrap"
                         TextChanged="OnTextChanged" PreviewKeyDown="OnInputKeyDown" AutomationProperties.Name="빠른 추가 입력" />
                <TextBlock x:Name="Placeholder" FontSize="17" Margin="2,1,0,0" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"
                           Text="예: 내일 오후 3시 치과 #개인 !높음 30분 전 알림" />
            </Grid>
        </Grid>
        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource RowLineBrush}" BorderThickness="0,1,0,1" Padding="18,10">
            <StackPanel>
                <TextBlock x:Name="SummaryText" FontSize="13" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="TitleText" FontSize="12" Margin="0,4,0,0" Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
        <DockPanel Margin="18,7" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                       Text="Enter 저장 · Ctrl+Enter 저장 후 계속 입력 · Tab 저장 후 자세히 · Esc 닫기" />
            <TextBlock DockPanel.Dock="Right" x:Name="ResultText" FontSize="11.5" Foreground="{DynamicResource SuccessBrush}" />
        </DockPanel>
    </StackPanel>
</Window>
