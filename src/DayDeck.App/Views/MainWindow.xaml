<Window x:Class="DayDeck.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DayDeck.App.ViewModels"
        xmlns:views="clr-namespace:DayDeck.App.Views"
        Title="DayDeck"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        FontFamily="{DynamicResource UiFont}"
        Background="{DynamicResource BgBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate x:Key="NavTemplate" DataType="{x:Type vm:NavItem}">
            <Grid x:Name="Root">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Icon" Text="{Binding Icon}" FontSize="13" Foreground="{DynamicResource SubTextBrush}" VerticalAlignment="Center" />
                <Ellipse x:Name="Dot" Width="9" Height="9" Fill="{Binding Dot}" HorizontalAlignment="Left" Margin="3,0,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border x:Name="CountBadge" Grid.Column="2" CornerRadius="8" Padding="6,0" MinWidth="18" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource SubTextBrush}"
                               HorizontalAlignment="Center" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasDot}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowAlertBadge}" Value="True">
                    <Setter TargetName="CountBadge" Property="Background" Value="{DynamicResource DangerBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="White" />
                    <Setter TargetName="CountText" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="TitleText" Property="FontSize" Value="11" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource MutedBrush}" />
                    <Setter TargetName="Root" Property="Margin" Value="-12,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                    <Setter TargetName="Root" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:NavItemKind.Action}">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽 탐색 -->
        <ListBox x:Name="Nav" Grid.Row="0" Grid.Column="0" Margin="8,12,8,8"
                 Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource NavTemplate}" VirtualizingPanel.IsVirtualizing="False"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnNavSelectionChanged"
                 AllowDrop="True" DragOver="OnNavDragOver" Drop="OnNavDrop"
                 ContextMenuOpening="OnNavContextMenuOpening">
            <ListBox.ItemContainerStyle>
                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource NavItemStyle}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelectable}" Value="False">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                            <Setter Property="Height" Value="28" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                            <Setter Property="Height" Value="13" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                        <Border Height="1" Margin="10,6" Background="{DynamicResource LineBrush}" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu />
            </ListBox.ContextMenu>
        </ListBox>

        <!-- 본문 -->
        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl x:Name="PageHost" Margin="28,22,24,16" Focusable="False" />
        </Border>

        <!-- 상태 표시줄 -->
        <!-- 탐색 메뉴 너비: 끌어서 조절, 저장 -->
        <views:PaneSplitter Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right" Margin="0,0,-3,0" Panel.ZIndex="10"
                            TargetColumn="{x:Reference NavColumn}" Key="main.nav" MinSize="150" MaxSize="420" KeepRest="420"
                            AutomationProperties.AutomationId="NavSplitter" />

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0" LastChildFill="False">
                <TextBlock x:Name="SaveStatus" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource SuccessBrush}" MinWidth="120" />
                <TextBlock x:Name="AutoSaveInfo" DockPanel.Dock="Left" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"
                           Foreground="{DynamicResource SubTextBrush}" />
                <Border x:Name="UndoBar" DockPanel.Dock="Left" Margin="24,0,0,0" Padding="10,2" CornerRadius="4" Background="{DynamicResource ToastBrush}"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="UndoText" Foreground="White" FontSize="11" VerticalAlignment="Center" MaxWidth="320"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Margin="12,0,0,0" FontSize="11" VerticalAlignment="Center">
                            <Hyperlink Foreground="#7CC4FF" Click="OnUndoClick">실행 취소</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="MemoryStatus" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource SubTextBrush}" ToolTip="작업 관리자의 &quot;메모리(활성 개인 작업 집합)&quot;과 같은 값입니다. 이 창을 닫으면 트레이 상주 상태로 메모리를 반환합니다." />
            </DockPanel>
        </Border>
    </Grid>
</Window>
