<UserControl x:Class="DayDeck.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}">설정</TextBlock>
            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">변경하면 바로 저장됩니다.</TextBlock>

            <TextBlock Style="{StaticResource SectionHeader}">시작</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="RunAtLogin" Content="Windows에 로그인하면 자동으로 실행" Checked="OnChanged" Unchecked="OnChanged" />
                    <CheckBox x:Name="StartMinimized" Content="자동 실행 시 창 없이 트레이에서 시작" Margin="24,6,0,6" Checked="OnChanged" Unchecked="OnChanged" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">단축키 (어디서나)</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <CheckBox x:Name="HotkeyQuickAddEnabled" Content="빠른 추가" Width="140" FontSize="13" VerticalAlignment="Center"
                                  AutomationProperties.Name="빠른 추가 단축키 사용" Checked="OnHotkeyEnabledChanged" Unchecked="OnHotkeyEnabledChanged" />
                        <TextBox x:Name="HotkeyQuickAdd" Width="170" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" Padding="3" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <CheckBox x:Name="HotkeyOpenMainEnabled" Content="창 열기/숨기기" Width="140" FontSize="13" VerticalAlignment="Center"
                                  AutomationProperties.Name="창 열기 단축키 사용" Checked="OnHotkeyEnabledChanged" Unchecked="OnHotkeyEnabledChanged" />
                        <TextBox x:Name="HotkeyOpenMain" Width="170" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" Padding="3" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <CheckBox x:Name="HotkeyNewNoteEnabled" Content="새 메모" Width="140" FontSize="13" VerticalAlignment="Center"
                                  AutomationProperties.Name="새 메모 단축키 사용" Checked="OnHotkeyEnabledChanged" Unchecked="OnHotkeyEnabledChanged" />
                        <TextBox x:Name="HotkeyNewNote" Width="170" IsReadOnly="True" PreviewKeyDown="OnHotkeyKeyDown" Padding="3" />
                        <Button Content="기본값" Padding="10,2" Margin="8,0,0,0" Click="OnHotkeyDefaults" />
                    </StackPanel>
                    <TextBlock x:Name="HotkeyStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="다른 프로그램의 단축키와 겹치면 체크를 끄세요. 끈 단축키는 등록하지 않습니다." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">단축키 (메모 쓰기)</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="FormatShortcuts" Content="서식 단축키 사용 (Ctrl+B 굵게, Ctrl+I 기울임, Ctrl+U 밑줄, Ctrl+K 링크 …)"
                              Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,4"
                               Text="메모·할 일 메모·일정 메모에 적용됩니다. 끄면 서식은 도구 단추로만 넣고, Ctrl+K는 전체 검색이 됩니다." />
                    <CheckBox x:Name="PasteImages" Content="Ctrl+V로 클립보드의 그림 붙여 넣기 (마크다운 메모)" Margin="0,6,0,0"
                              Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,4"
                               Text="끄면 그림은 서식 도구의 🖼 단추나 파일 끌어다 놓기로 넣습니다." />
                    <CheckBox x:Name="StartInObsidianMode" Content="메모를 옵시디언 모드로 열기" Margin="0,6,0,0"
                              Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,4"
                               Text="원문에 서식을 입혀 보이고 커서가 있는 줄만 서식 기호(**, #, 링크 주소)가 보입니다. 끄면 &quot;보기&quot;로 엽니다." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">트레이</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="CloseToTray" Content="창을 닫으면(X) 트레이로 숨기기" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,4">
                        끄면 창을 닫을 때 프로그램이 종료되고 알림도 울리지 않습니다.
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,3">
                        <TextBlock Text="아이콘 클릭" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="TrayClick" Width="200" SelectionChanged="OnChanged" AutomationProperties.Name="아이콘 클릭" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,4" Text="두 번 클릭하면 항상 메인 창이 열립니다." />
                    <CheckBox x:Name="ShowBadge" Content="기한 지난 할 일이나 확인 안 한 알림이 있으면 아이콘에 빨간 점" Checked="OnChanged" Unchecked="OnChanged" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">알림</TextBlock>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Margin" Value="0,5,16,5" />
                        </Style>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Setter Property="Width" Value="140" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Margin" Value="0,3" />
                        </Style>
                    </Grid.Resources>

                    <TextBlock Grid.Row="0" Text="마감을 정하면 자동으로 붙는 알림" />
                    <ComboBox Grid.Row="0" Grid.Column="1" x:Name="DefaultReminder" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="1" Text="날짜만 있는 마감의 알림 시각" />
                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DateOnlyTime" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="2" Text="스누즈 기본 시간" />
                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="SnoozeMinutes" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="3" Text="끈질긴 알림 반복 간격" />
                    <ComboBox Grid.Row="3" Grid.Column="1" x:Name="PersistentMinutes" SelectionChanged="OnChanged" />

                    <TextBlock Grid.Row="4" Text="알림 소리" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="SoundChoice" SelectionChanged="OnChanged" />
                        <Button Content="▶ 들어 보기" Padding="10,2" Margin="8,3,0,3" Click="OnTestSound" />
                    </StackPanel>

                    <CheckBox Grid.Row="5" x:Name="BriefingEnabled" Content="매일 오늘의 할 일 브리핑" Checked="OnChanged" Unchecked="OnChanged" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">
                        <ComboBox x:Name="BriefingTime" SelectionChanged="OnChanged" />
                        <Button Content="지금 보기" Padding="10,2" Margin="8,3,0,3" Click="OnShowBriefing" />
                    </StackPanel>

                    <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="알림은 화면 오른쪽 아래에 팝업으로 뜨고, 처리할 때까지 남아 있습니다. 집중 모드나 Windows 알림 설정과 상관없이 보입니다. PC가 꺼져 있거나 절전 중에 지난 알림은 다시 켰을 때 '놓친 알림'으로 보여 줍니다." />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">화면</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="테마" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="ThemeChoice" Width="170" SelectionChanged="OnChanged" AutomationProperties.Name="테마" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="글꼴" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="UiFontChoice" Width="220" SelectionChanged="OnChanged" AutomationProperties.Name="글꼴"
                                  MaxDropDownHeight="360" />
                        <ComboBox x:Name="UiFontSize" Width="110" Margin="8,0,0,0" SelectionChanged="OnChanged" AutomationProperties.Name="글자 크기" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="메모 편집기 글꼴" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="EditorFontChoice" Width="220" SelectionChanged="OnChanged" AutomationProperties.Name="메모 글꼴"
                                  MaxDropDownHeight="360" />
                        <ComboBox x:Name="EditorFontSize" Width="110" Margin="8,0,0,0" SelectionChanged="OnChanged" AutomationProperties.Name="메모 글자 크기" />
                    </StackPanel>
                    <TextBlock x:Name="FontPreview" Margin="120,2,0,6" FontSize="13" Foreground="{DynamicResource SubTextBrush}"
                               Text="가나다 ABC 123 — 다람쥐 헌 쳇바퀴에 타고파" />
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="완료한 할 일" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="CompletedDisplayChoice" Width="170" SelectionChanged="OnChanged" AutomationProperties.Name="완료한 할 일" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,6">
                        <TextBlock Text="화면 배치" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <Button Content="처음 배치로 되돌리기" Padding="10,3" Click="OnResetLayout" />
                        <TextBlock x:Name="LayoutStatus" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}"
                                   Text="구역 경계선을 끌어서 너비를 바꿀 수 있고, 창 크기와 함께 저장됩니다." />
                    </StackPanel>
                    <CheckBox x:Name="WidgetEnabled" Content="바탕화면 위젯 표시 (오늘 할 일과 일정)" Margin="0,8,0,0" Checked="OnChanged" Unchecked="OnChanged" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">달력</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="한 주의 시작" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="WeekStart" Width="110" SelectionChanged="OnChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="시간 단위" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="SlotMinutes" Width="110" SelectionChanged="OnChanged" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3">
                        <TextBlock Text="근무 시간" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <ComboBox x:Name="WorkStart" Width="80" SelectionChanged="OnChanged" AutomationProperties.Name="근무 시작" />
                        <TextBlock Text=" – " VerticalAlignment="Center" />
                        <ComboBox x:Name="WorkEnd" Width="80" SelectionChanged="OnChanged" AutomationProperties.Name="근무 끝" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="120,0,0,4" Text="주/일 보기에서 근무 시간 밖은 옅게 칠하고, 처음에 근무 시작 무렵을 보여 줍니다." />
                    <CheckBox x:Name="ShowHolidays" Content="대한민국 공휴일 표시 (대체공휴일 포함, 선거일·임시공휴일 제외)" Checked="OnChanged" Unchecked="OnChanged" />
                    <CheckBox x:Name="ShowLunar" Content="월 보기에 음력 날짜 표시" Checked="OnChanged" Unchecked="OnChanged" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">자동 저장</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4">
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextBrush}">저장 간격</TextBlock>
                        <ComboBox x:Name="AutoSaveInterval" Width="110" Margin="12,0,0,0" SelectionChanged="OnChanged" />
                    </StackPanel>
                    <CheckBox x:Name="SaveAfterEdit" Content="편집을 멈추면 3초 뒤 바로 저장" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock Style="{StaticResource Hint}" Margin="24,0,0,4">
                        두 방식을 함께 쓰면 비정상 종료 시에도 잃는 내용이 거의 없습니다.
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">데이터</TextBlock>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="데이터 폴더" Margin="0,6,16,6" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DataFolder" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Row="0" Grid.Column="2" Content="열기" Padding="12,3" Margin="12,4,0,4" Click="OnOpenDataFolder" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="메모 폴더" Margin="0,6,16,6" VerticalAlignment="Center" FontSize="13" />
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="NotesFolder" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource SubTextBrush}" TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" x:Name="PortableHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">백업 · 가져오기 · 내보내기</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="지금 백업" Padding="12,3" Click="OnBackupNow" />
                        <Button Content="백업 폴더 열기" Padding="12,3" Margin="6,0,0,0" Click="OnOpenBackups" />
                        <TextBlock x:Name="BackupStatus" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource SubTextBrush}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,6"
                               Text="하루 한 번 자동으로 DB·설정·메모를 zip으로 백업하고 최근 14개를 남깁니다. 복원하려면 앱을 종료하고 zip을 데이터 폴더에 풀면 됩니다." />
                    <DockPanel Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="기본 위치로" Padding="10,3" Margin="6,0,0,0" Click="OnResetBackupFolder" x:Name="ResetBackupFolder" />
                        <Button DockPanel.Dock="Right" Content="위치 변경…" Padding="10,3" Margin="6,0,0,0" Click="OnChangeBackupFolder" />
                        <TextBlock Text="백업 위치" Width="80" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left" />
                        <TextBox x:Name="BackupFolder" IsReadOnly="True" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontSize="12" Foreground="{DynamicResource SubTextBrush}" AutomationProperties.Name="백업 위치" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <Button Content="📅 ICS 가져오기…" Padding="12,3" Click="OnImportIcs" />
                        <Button Content="ICS 내보내기…" Padding="12,3" Margin="6,0,0,0" Click="OnExportIcs" />
                        <Button Content="할 일 CSV 내보내기…" Padding="12,3" Margin="6,0,0,0" Click="OnExportCsv" />
                    </StackPanel>
                    <TextBlock x:Name="ExchangeStatus" Style="{StaticResource Hint}" Margin="0,4,0,0"
                               Text="ICS는 구글 캘린더·Outlook·아이폰 달력과 주고받을 수 있습니다 (일정과 할 일, 반복 포함)." />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">업데이트</TextBlock>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <CheckBox x:Name="AutoUpdateCheck" Content="새 버전이 나오면 알려 주기 (하루 한 번 확인)" Checked="OnChanged" Unchecked="OnChanged" />
                    <TextBlock x:Name="AutoUpdateHint" Style="{StaticResource Hint}" Margin="24,0,0,4"
                               Text="설치는 항상 확인 창에서 &quot;지금 업데이트&quot;를 눌러야 시작합니다. 설치 전에 데이터를 백업하고, 데이터는 그대로 둡니다." />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock x:Name="CurrentVersionText" Width="120" FontSize="13" VerticalAlignment="Center" />
                        <Button x:Name="CheckUpdateButton" Content="지금 확인" Padding="10,3" Click="OnCheckUpdate" />
                        <TextBlock x:Name="UpdateStatus" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubTextBrush}" AutomationProperties.AutomationId="UpdateStatus" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionHeader}">정보</TextBlock>
            <Border Style="{StaticResource Card}" Margin="0,0,0,24">
                <TextBlock x:Name="AboutText" Style="{StaticResource Hint}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
