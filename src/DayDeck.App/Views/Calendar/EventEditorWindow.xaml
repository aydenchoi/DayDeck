<Window x:Class="DayDeck.App.Views.Calendar.EventEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DayDeck.App.Views"
        Title="일정" Width="520" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}">
    <Window.Resources>
        <Style x:Key="Label" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource SubTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style x:Key="DayToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="ChipToggle" TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <Grid>
            <TextBox x:Name="TitleBox" FontSize="18" FontWeight="SemiBold" Padding="2,4" BorderThickness="0,0,0,1"
                     BorderBrush="{DynamicResource LineBrush}" Background="Transparent" />
            <TextBlock x:Name="TitlePlaceholder" Text="일정 제목" FontSize="18" Foreground="{DynamicResource MutedBrush}"
                       Margin="5,4,0,0" IsHitTestVisible="False" />
        </Grid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CheckBox Grid.Row="0" Grid.Column="1" x:Name="AllDayBox" Content="종일" Margin="0,0,0,8" Click="OnAllDayChanged" />

            <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="시작" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <DatePicker x:Name="StartDate" Width="190" SelectedDateChanged="OnStartDateChanged" />
                <ComboBox x:Name="StartTime" Width="90" Margin="6,0,0,0" MaxDropDownHeight="260" SelectionChanged="OnStartTimeChanged" />
            </StackPanel>

            <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="끝" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
                <DatePicker x:Name="EndDate" Width="190" />
                <ComboBox x:Name="EndTime" Width="90" Margin="6,0,0,0" MaxDropDownHeight="260" />
                <TextBlock x:Name="DurationText" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="반복" />
            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="RepeatChoice" Width="120" SelectionChanged="OnRepeatChanged">
                        <ComboBoxItem Content="반복 안 함" />
                        <ComboBoxItem Content="매일" />
                        <ComboBoxItem Content="매주" />
                        <ComboBoxItem Content="매월" />
                        <ComboBoxItem Content="매년" />
                    </ComboBox>
                    <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="10,0,0,0">
                        <TextBox x:Name="IntervalBox" Width="36" Text="1" VerticalContentAlignment="Center" TextChanged="OnRuleInputChanged" />
                        <TextBlock x:Name="IntervalUnit" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="WeekDaysPanel" Orientation="Horizontal" Margin="0,6,0,0" />
                <StackPanel x:Name="MonthModePanel" Margin="0,6,0,0">
                    <RadioButton x:Name="MonthByDay" GroupName="MonthMode" Margin="0,2" Checked="OnRuleInputChanged" />
                    <RadioButton x:Name="MonthByWeekday" GroupName="MonthMode" Margin="0,2" Checked="OnRuleInputChanged" />
                    <RadioButton x:Name="MonthByLastWeekday" GroupName="MonthMode" Margin="0,2" Checked="OnRuleInputChanged" />
                </StackPanel>
                <StackPanel x:Name="EndPanel" Orientation="Horizontal" Margin="0,6,0,0">
                    <ComboBox x:Name="EndChoice" Width="100" SelectionChanged="OnRuleInputChanged">
                        <ComboBoxItem Content="계속" />
                        <ComboBoxItem Content="횟수" />
                        <ComboBoxItem Content="날짜까지" />
                    </ComboBox>
                    <TextBox x:Name="CountBox" Width="44" Margin="6,0,0,0" Text="10" VerticalContentAlignment="Center" TextChanged="OnRuleInputChanged" />
                    <DatePicker x:Name="UntilDate" Width="170" Margin="6,0,0,0" SelectedDateChanged="OnRuleInputChanged" />
                </StackPanel>
                <TextBlock x:Name="RuleSummary" Margin="0,4,0,0" FontSize="11.5" Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="장소" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="LocationBox" Margin="0,0,0,6" Padding="2,3" />

            <TextBlock Grid.Row="5" Style="{StaticResource Label}" Text="목록" />
            <ComboBox Grid.Row="5" Grid.Column="1" x:Name="ListChoice" Width="190" HorizontalAlignment="Left" Margin="0,0,0,6" />

            <TextBlock Grid.Row="6" Style="{StaticResource Label}" Text="알림" VerticalAlignment="Top" Margin="0,4,12,0" />
            <WrapPanel Grid.Row="6" Grid.Column="1" x:Name="ReminderPanel" Margin="0,0,0,6" />

            <TextBlock Grid.Row="7" Style="{StaticResource Label}" Text="메모" VerticalAlignment="Top" Margin="0,4,12,0" />
            <StackPanel Grid.Row="7" Grid.Column="1">
                <views:MarkdownToolbar x:Name="NotesToolbar" Margin="0,0,0,3" />
                <Grid>
                    <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="240" Padding="3"
                             VerticalScrollBarVisibility="Auto" AutomationProperties.Name="일정 메모" />
                    <Border x:Name="NotesPreviewHost" MinHeight="64" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Visibility="Collapsed">
                        <FlowDocumentScrollViewer x:Name="NotesPreview" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False"
                                                  MaxHeight="240" AutomationProperties.AutomationId="EventNotesPreview" />
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>

        <DockPanel Margin="0,16,0,0">
            <Button DockPanel.Dock="Left" x:Name="DeleteButton" Content="🗑 삭제" Padding="12,4" Foreground="{DynamicResource DangerBrush}" Background="Transparent"
                    BorderThickness="0" Click="OnDelete" />
            <Button DockPanel.Dock="Left" x:Name="CompleteButton" Content="✓ 완료" Padding="12,4" Margin="4,0,0,0" Click="OnToggleComplete" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="저장" Width="84" Padding="0,5" IsDefault="True" Click="OnSave" />
                <Button Content="취소" Width="84" Padding="0,5" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
