<Window x:Class="DayDeck.App.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DayDeck 위젯" Width="300" Height="420" MinWidth="220" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="{DynamicResource UiFont}" Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="14,10,10,10">
        <DockPanel DockPanel.Dock="Top" MouseLeftButtonDown="OnDrag" Background="Transparent">
            <Button DockPanel.Dock="Right" Content="⤢" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource SubTextBrush}" Click="OnOpenMain" ToolTip="DayDeck 열기" AutomationProperties.Name="열기" />
            <Button DockPanel.Dock="Right" Content="＋" Width="24" Height="24" Background="Transparent" BorderThickness="0"
                    Foreground="{DynamicResource AccentBrush}" Click="OnQuickAdd" ToolTip="빠른 추가" AutomationProperties.Name="빠른 추가" />
            <StackPanel>
                <TextBlock x:Name="DateText" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
            </StackPanel>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </DockPanel>
</Window>
