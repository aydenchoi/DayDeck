<Window x:Class="DayDeck.App.Views.TodayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="오늘" Width="320" SizeToContent="Height" MaxHeight="520"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        FontFamily="{DynamicResource UiFont}" Background="{DynamicResource PopupBrush}"
        BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel Margin="14,10,12,10">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="DateText" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="SummaryText" FontSize="11.5" Foreground="{DynamicResource SubTextBrush}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="＋ 빠른 추가" Padding="10,3" Margin="0,0,6,0" Click="OnQuickAdd" />
            <Button Content="메인 창 열기" Padding="10,3" Click="OnOpenMain" Style="{StaticResource AccentButton}" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <StackPanel x:Name="Body" />
        </ScrollViewer>
    </DockPanel>
</Window>
